# -*- coding: utf-8 -*-

import sys
import json
from datetime import datetime
import pytz

fichero = sys.argv[1]
#    with open('datos_observacion.json') as file:

def leer_archivo_json():
    with open(fichero,'r', encoding='latin-1') as file:
        data = json.load(file)
    
    fecha_objetos = []
    for item in data:
        fint_str = item.get('fint', '')
        if fint_str:
            fecha_utc = datetime.strptime(fint_str, '%Y-%m-%dT%H:%M:%S').replace(tzinfo=pytz.UTC)
            fecha_objetos.append(fecha_utc)
    
    return fecha_objetos

leer_archivo_json()
